{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ani 2027",
  "version": "2027.0.0",
  "identifier": "com.michiganmindmend.ani2027",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ani 2027 — MindMend Local AI Command Center",
