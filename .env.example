# Luna backend configuration (copy to .env and adjust for local development)
#
# Required
LUNA_SECRET_KEY=replace-with-a-long-random-secret

# Optional Firebase push alerts
# LUNA_FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Safe-zone defaults (Detroit example coordinates)
LUNA_SAFE_LAT=42.3314
LUNA_SAFE_LON=-83.0458
LUNA_SAFE_RADIUS_KM=5

# Server defaults (127.0.0.1 is recommended for local development)
LUNA_FLASK_HOST=127.0.0.1
LUNA_FLASK_PORT=5000
LUNA_FLASK_DEBUG=false

# Require JWT bearer auth on /check_chat and /check_location.
# Safe default is true. Set false only for a deliberate local-only demo.
LUNA_REQUIRE_AUTH=true

# Protect /auth_kid in development; omit only for local token issuance.
# LUNA_AUTH_BOOTSTRAP_TOKEN=replace-with-bootstrap-token
